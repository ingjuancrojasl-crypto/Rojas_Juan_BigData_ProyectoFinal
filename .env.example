# Copie este archivo como .env y cambie los valores. Nunca suba el .env real al repositorio.
MONGO_USER=admin_quejas
MONGO_PASSWORD=cambie_esta_clave
MONGO_DB=quejas_financieras
MONGO_COLECCION=analisis

# Token de acceso a Jupyter Lab (http://localhost:8888/?token=...)
JUPYTER_TOKEN=cambie_este_token

# Puertos publicados en el equipo anfitrión
JUPYTER_PORT=8888
STREAMLIT_PORT=8501
MONGO_PORT=27017

# 1 = repetir el ETL aunque el Parquet ya exista
FORZAR_ETL=0

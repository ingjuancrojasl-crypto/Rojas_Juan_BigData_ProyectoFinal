# Copie este archivo como .env y cambie los valores. Nunca suba el .env real al repositorio.
#   Windows PowerShell:  copy .env.example .env
#   Linux / macOS:       cp .env.example .env
MONGO_USER=admin_siniestros
MONGO_PASSWORD=cambie_esta_clave
MONGO_DB=siniestros_transporte
MONGO_COLECCION=analisis

# Token de acceso a Jupyter Lab (http://localhost:8888/?token=...)
JUPYTER_TOKEN=cambie_este_token

# Puertos publicados en el equipo anfitrión (cámbielos si ya están ocupados)
JUPYTER_PORT=8888
STREAMLIT_PORT=8501
MONGO_PORT=27017

# 1 = ejecutar otra vez el notebook completo (ETL + modelo) aunque los resultados ya existan
FORZAR_PIPELINE=0
